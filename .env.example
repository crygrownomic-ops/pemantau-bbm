# ============================================================
# FleetOps 360 - contoh variabel lingkungan
# Salin menjadi .env.local untuk pengembangan lokal.
# Jangan pernah commit file .env.local atau kredensial asli.
# ============================================================

# Kunci penandatanganan cookie sesi (HMAC-SHA256).
# Wajib diganti di produksi. Gunakan string acak minimal 32 karakter.
# Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Direktori penyimpanan database JSON. Default: ./data
# Berisi platform.json dan subfolder tenants/.
# Hanya dipakai bila DATABASE_URL kosong (pengembangan lokal / VPS dengan disk).
# Gunakan path absolut pada server produksi agar persisten.
# FLEETOPS_DATA_DIR=

# ------------------------------------------------------------
# Database Postgres (WAJIB untuk Vercel / hosting serverless)
# ------------------------------------------------------------
# Kosongkan saat lokal untuk memakai file JSON di ./data.
# Isi dengan connection string Postgres gratis (Supabase / Neon / Vercel Postgres).
# Tabel fleetops_documents dibuat otomatis saat aplikasi pertama kali dipakai.
# Contoh Supabase (pakai connection pooling port 6543):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Contoh Neon (pakai host -pooler):
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=
# Jumlah koneksi per instance serverless. Biarkan 4 kecuali pooler membatasi.
# PG_POOL_MAX=4

# ------------------------------------------------------------
# Platform Owner (konsol SaaS: tenant, paket, invoice)
# ------------------------------------------------------------
PLATFORM_USERNAME=owner
PLATFORM_NAME=Platform Owner
# Untuk lokal/demo boleh memakai password polos:
PLATFORM_PASSWORD=owner123
# Untuk produksi gunakan hash scrypt dan hapus PLATFORM_PASSWORD:
# PLATFORM_PASSWORD_HASH=scrypt$<salt>$<key>

# ------------------------------------------------------------
# Akun administrator tenant bawaan (kode perusahaan: demo)
# Variabel ini HANYA berlaku untuk tenant hasil migrasi data lama.
# Tenant baru memakai akun yang tersimpan di database tenant.
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator FleetOps
# Untuk lokal/demo boleh memakai password polos:
ADMIN_PASSWORD=admin123
# Untuk produksi gunakan hash scrypt dan hapus ADMIN_PASSWORD:
# ADMIN_PASSWORD_HASH=scrypt$<salt>$<key>

# ------------------------------------------------------------
# Akun driver tenant bawaan
# ------------------------------------------------------------
# DRIVER_NAME harus sama dengan nama driver pada master data
# agar transaksi dan klaim terhubung ke driver tersebut.
DRIVER_USERNAME=driver
DRIVER_NAME=Ahmad Supardi
DRIVER_PASSWORD=driver123
# DRIVER_PASSWORD_HASH=scrypt$<salt>$<key>

# ------------------------------------------------------------
# Akun operator tambahan (opsional, peran admin, tenant bawaan)
# ------------------------------------------------------------
# OPERATOR_USERNAME=operator
# OPERATOR_NAME=Fleet Operator
# OPERATOR_PASSWORD=ganti-password-ini
# OPERATOR_PASSWORD_HASH=scrypt$<salt>$<key>
